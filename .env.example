# Copy to .env and change every value marked CHANGE_ME:   cp .env.example .env
# .env is git-ignored: real credentials never go to the repository.

# --- PostgreSQL (superuser, only for administration from DBeaver) ---
POSTGRES_DB=bi_paros
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=CHANGE_ME_admin
# Host port for DBeaver and Power BI. 5433 avoids clashing with a PostgreSQL
# already installed on the host; the Power BI project (PBIP) points to localhost:5433.
DB_PORT=5433

# --- Least-privilege users created by sql/init/99_roles.sh ---
ETL_DB_USER=etl_user
ETL_DB_PASSWORD=CHANGE_ME_etl
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=CHANGE_ME_grafana
POWERBI_DB_USER=powerbi_ro
POWERBI_DB_PASSWORD=CHANGE_ME_powerbi

# --- ETL ---
# File name inside ./data/raw/ (the Excel is NOT versioned: it contains personal data)
SOURCE_FILE_NAME=SEGUIMIENTO TEMPERAS Y VINILOS Actividad.xlsm
# Secret used to pseudonymize people names (SHA-256 + salt). Keep it private.
PSEUDONYM_SALT=CHANGE_ME_long_random_string

# --- Simulator: seconds of real time per simulated plant hour ---
SIM_TICK_SECONDS=30

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin

# --- CloudBeaver (optional web DBeaver, profile "tools", 127.0.0.1 only) ---
# Start it with: docker compose --profile tools up -d
# Its admin user is created in the web wizard on first start (not stored here).
CLOUDBEAVER_PORT=8978
