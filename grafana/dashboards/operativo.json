        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-dw"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT make_date(anio, mes, 1)::timestamptz AS time, maquina_nk AS metric,\n       ROUND(oee * 100, 1) AS value\nFROM dw.vw_kpi_mensual_maquina\nWHERE oee IS NOT NULL AND maquina_nk IN ($maquina)\nORDER BY 1"
        }
      ],
      "description": "Datos históricos del ETL (2023–2025) para comparar el tiempo real con la línea base.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
