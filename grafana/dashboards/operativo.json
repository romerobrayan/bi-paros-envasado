                        "index": 0
                      },
                      "resolved": {
                        "color": "green",
                        "text": "RESUELTA",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "title": "Contexto histórico: OEE mensual por máquina",
